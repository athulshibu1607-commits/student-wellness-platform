datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum HabitCategory {
  COGNITIVE
  HEALTH
  ACADEMIC
  REST
}

enum GoalCategory {
  EXAM
  PROJECT
  PLACEMENT
  RESEARCH
}

enum PartnerStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String?
  name              String
  avatar            String?
  role              Role              @default(STUDENT)
  major             String            @default("Computer Science & Engineering")
  semester          Int               @default(5)
  weeklyTargetHours Float             @default(25.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  courses           Course[]
  tasks             Task[]
  focusSessions     FocusSession[]
  wellnessCheckins  WellnessCheckin[]
  conversations     MentorConversation[]
  mentorMessages    MentorMessage[]
  posts             CommunityPost[]
  comments          CommunityComment[]
  notifications     Notification[]
  habits            Habit[]
  habitLogs         HabitLog[]
  goals             Goal[]
  roomMemberships   RoomMembership[]
  partnerRequestsSent     AccountabilityRelationship[] @relation("UserPartnersSent")
  partnerRequestsReceived AccountabilityRelationship[] @relation("UserPartnersReceived")

  @@index([email])
}

model Course {
  id          String   @id @default(uuid())
  userId      String
  code        String   // e.g. "CS301"
  name        String   // e.g. "Operating Systems"
  credits     Int      @default(4)
  professor   String?
  color       String   @default("#0ea5e9") // hex accent
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks       Task[]
  goals       Goal[]

  @@index([userId])
}

model Task {
  id               String       @id @default(uuid())
  userId           String
  courseId         String?
  title            String
  description      String?
  priority         Priority     @default(MEDIUM)
  status           TaskStatus   @default(BACKLOG)
  dueDate          DateTime?
  estimatedMinutes Int          @default(60)
  completedMinutes Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  focusSessions    FocusSession[]

  @@index([userId])
  @@index([courseId])
  @@index([dueDate])
  @@index([status])
}

model FocusSession {
  id              String    @id @default(uuid())
  userId          String
  taskId          String?
  durationMinutes Int
  sessionType     String    @default("pomodoro") // pomodoro, flow, deepwork
  environment3D   String    @default("sanctum")  // sanctum, cosmos, zen
  notes           String?
  rating          Int?      @default(5)
  completedAt     DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([completedAt])
}

model WellnessCheckin {
  id              String    @id @default(uuid())
  userId          String
  moodScore       Int       // 1 (drained) to 5 (energized)
  stressScore     Int       // 1 (calm) to 5 (extreme pressure)
  sleepHours      Float     @default(7.0)
  energyLevel     Int       // 1 to 5
  notes           String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model MentorConversation {
  id              String          @id @default(uuid())
  userId          String
  title           String          @default("Academic Consultation")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        MentorMessage[]

  @@index([userId])
}

model MentorMessage {
  id              String              @id @default(uuid())
  userId          String
  conversationId  String?
  sender          String              // "user" or "mentor_ai"
  content         String
  isCrisisAlert   Boolean             @default(false)
  createdAt       DateTime            @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    MentorConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([conversationId])
}

model CommunityPost {
  id          String             @id @default(uuid())
  authorId    String
  title       String
  content     String
  tag         String             @default("General")
  upvotes     Int                @default(0)
  isAnonymous Boolean            @default(false)
  createdAt   DateTime           @default(now())

  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    CommunityComment[]

  @@index([authorId])
  @@index([tag])
  @@index([createdAt])
}

model CommunityComment {
  id        String        @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime      @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model StudyRoom {
  id              String           @id @default(uuid())
  name            String
  courseCode      String           // e.g. "CS301" or "GENERAL"
  topic           String
  soundscape      String           @default("432Hz Ambient Drone")
  createdAt       DateTime         @default(now())

  memberships     RoomMembership[]
}

model RoomMembership {
  id          String    @id @default(uuid())
  roomId      String
  userId      String
  joinedAt    DateTime  @default(now())

  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model AccountabilityRelationship {
  id            String        @id @default(uuid())
  requesterId   String
  receiverId    String
  status        PartnerStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  requester     User          @relation("UserPartnersSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver      User          @relation("UserPartnersReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model Habit {
  id          String        @id @default(uuid())
  userId      String
  title       String
  category    HabitCategory @default(ACADEMIC)
  streakCount Int           @default(0)
  iconName    String        @default("check")
  color       String        @default("#0ea5e9")
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  userId    String
  date      String   // YYYY-MM-DD
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId])
}

model Goal {
  id          String       @id @default(uuid())
  userId      String
  courseId    String?
  title       String
  targetDate  DateTime
  category    GoalCategory @default(EXAM)
  progress    Int          @default(0) // 0-100
  isCompleted Boolean      @default(false)
  priority    Priority     @default(HIGH)
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
}
